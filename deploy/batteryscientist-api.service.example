# User service: ~/.config/systemd/user/batteryscientist-api.service
[Unit]
Description=BatteryScientist Workbench API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/xinghaohuang/batteryscientist
ExecStart=/home/xinghaohuang/batteryscientist/run-web-api
Restart=on-failure
RestartSec=3
# Preserve detached research workers when restarting the API.
KillMode=process
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
